include LICENSE
include README.md
include environment.yml
include CHANGELOG.md
include CITATION.cff
include CONTRIBUTING.md
recursive-include docs *.md
exclude docs/release_checklist.md
exclude docs/reproducibility.md
include docs/benchmark_config.example.json
include docs/benchmark_quickstart.example.json
include docs/benchmark_manifest_template.csv
include docs/sensitivity_axes.example.json
include docs/assets/topoppi-gui-sanitized.png
include docs/assets/topoppi-gui-3d.png
include docs/assets/topoppi-output-atlas.png
include docs/assets/topoppi-output-surface.png
include docs/assets/topoppi-output-markers.png
include docs/assets/topoppi-output-values.png
recursive-include src/topoppi/assets *.ico *.png
include src/topoppi/assets/plugins.json
recursive-include src/topoppi/assets/examples *.pdb *.md
recursive-include src/topoppi_chemistry *.py
recursive-include installer/windows *.iss *.ps1 *.pyw *.md
recursive-include installer/macos *.sh *.py *.md *.in *.c TopoPPI
include installer/smoke_footprints.py
include tools/README.md
include tools/OptCuts/NOTICE.md
include tools/OptCuts/LICENSE.txt
include tools/OptCuts/THIRD_PARTY_LICENSES.txt
include tools/OptCuts/install_optcuts.sh
include tools/OptCuts/build_residue_aware_optcuts.sh
include tools/OptCuts/build_windows_optcuts.ps1
recursive-include tools/OptCuts/residue_aware *.cpp *.hpp *.md *.patch
recursive-include tools/OptCuts/reproducible *.patch
include tests/fixtures/prolif_interactions.json
recursive-include tests *.py *.md *.json *.pdb
recursive-exclude .github *
recursive-exclude dist *
recursive-exclude build *
recursive-exclude *.egg-info *
recursive-exclude tools/OptCuts OptCuts*_bin*
recursive-exclude tools/OptCuts *.so *.exe
recursive-exclude tests/fixtures *_cutoff*_res*_sigma*_min*_*.png
recursive-exclude tests/fixtures *_cutoff*_res*_sigma*_min*_*.topoppi.json
prune .internal
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude .DS_Store

prune plugins

prune .storage
prune benchmark_results
prune output
prune TopoPPI_icon_assets
exclude AGENTS.md

include examples/plugin/topoppi_example_stats.py
include examples/plugin/pyproject.toml
include examples/plugin/README.md
prune examples/plugin/build

recursive-include src/topoppi_representation *.py
recursive-include scripts/analysis *.py *.md
include installer/smoke_affinity.py
include installer/smoke_binding.py
